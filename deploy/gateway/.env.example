# ============================================================
# .env.example — Gateway Lambda (configurar en Lambda Config Vars)
# ============================================================

# ---------- Google AI Studio (Gemini) ----------
GOOGLE_API_KEY=                      # Obtener en https://aistudio.google.com/app/apikey

# ---------- Modelo ----------
MODELO=gemini-3.5-flash-lite

# ---------- Telegram ----------
TELEGRAM_TOKEN=                      # Token de @BotFather
TELEGRAM_SECRET=                     # Secreto aleatorio para verificar webhook

# ---------- Agentes A2A (Heroku) ----------
A2A_HISTORIA_URL=                    # URL pública del agente historia
A2A_GEOGRAFIA_URL=                   # URL pública del agente geografía
A2A_HISTORIA_ASSISTANT_ID=           # assistant_id del agente historia
A2A_GEOGRAFIA_ASSISTANT_ID=          # assistant_id del agente geografía

# ---------- Google Cloud Speech-to-Text (integración avanzada: voz) ----------
GOOGLE_STT_API_KEY=                  # API key de Google Cloud Speech-to-Text
STT_LANGUAGE_CODE=es-CL              # Idioma de la transcripción

# ---------- AWS ----------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
