# ============================================================
# .env.example — Plantilla de variables de entorno
# Copiar a .env y completar los valores reales.
# NUNCA subir .env al repositorio.
# ============================================================

# ---------- Google AI Studio (Gemini) ----------
GOOGLE_API_KEY=                      # Obtener en https://aistudio.google.com/app/apikey

# ---------- Modelo ----------
MODELO=gemini-3.5-flash-lite

# ---------- API (control de acceso local) ----------
API_KEY=cambia-esta-clave-en-produccion

# ---------- Telegram (solo producción) ----------
TELEGRAM_TOKEN=                      # Token de @BotFather
TELEGRAM_SECRET=                     # Secreto aleatorio para verificar webhook

# ---------- URLs públicas (completar tras desplegar) ----------
PUBLIC_URL=                          # URL del gateway (Lambda Function URL)
A2A_HISTORIA_URL=                    # URL pública del agente historia
A2A_GEOGRAFIA_URL=                   # URL pública del agente geografía
A2A_HISTORIA_ASSISTANT_ID=           # assistant_id del agente historia
A2A_GEOGRAFIA_ASSISTANT_ID=          # assistant_id del agente geografía

# ---------- Google Cloud Speech-to-Text (integración avanzada: voz) ----------
GOOGLE_STT_API_KEY=                  # API key de Google Cloud Speech-to-Text
STT_LANGUAGE_CODE=es-CL              # Idioma de la transcripción

# ---------- Heroku (solo para CLI/automatización) ----------
HEROKU_API_KEY=                      # API Key de Heroku (dashboard.heroku.com/account)
HEROKU_APP_GATEWAY=grupo4-gateway-telegram
HEROKU_APP_HISTORIA=grupo4-agente-historia
HEROKU_APP_GEOGRAFIA=grupo4-agente-geografia

# ---------- AWS ----------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=

# ---------- Servidor local ----------
PORT=8000
HOST=0.0.0.0
